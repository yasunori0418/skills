{
  "description": "find / fd によるルート起点の全探索を禁止し、$HOME 直下起点の探索に深さ制限を強制する hook。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/broad-scan-guard/main.sh"
          }
        ]
      }
    ]
  }
}
